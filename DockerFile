#syntax=docker/dockerfile:1
#check=error=true
# This is a development environment intended to be used for ther current ML_ORD project.
FROM anaconda/miniconda:26.5.3
ENV CONDA_PLUGINS_AUTO_ACCEPT_TOS=true
# TODO: Make separate build stages for a development environment and a "release" environment.
COPY environment.yml .
# Install Python 3.7, R, and necessary C/C++ system dependencies for R packages
ENV DEBIAN_FRONTEND=non-interactive
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
--mount=type=cache,target=/var/lib/apt,sharing=locked \
    apt update && \
    apt install -y --no-install-recommends \
    build-essential \
    g++ \
    libcurl4-openssl-dev \
    libssl-dev \
    libxml2-dev \
    libfontconfig1-dev \
    libharfbuzz-dev \
    libfribidi-dev \
    libfreetype6-dev \
    libpng-dev \
    libtiff5-dev \
    gpg-agent \
    libjpeg-dev \
    ca-certificates \
    git \
    curl \
    git-lfs && \
    apt clean
RUN conda update conda && \ 
    conda config --set channel_priority flexible && \ 
    conda create --file environment.yml -n ML_ORD -v && \
    conda init && \ 
    conda run -n ML_ORD Rscript -e "options(repos = c(warn=2, renv.consent=TRUE)); renv::restore()"
CMD ["tail", "-f", "/dev/null"]